{
  "name": "datarecipe",
  "version": "0.1.0",
  "description": "Turn hundreds of websites into a clean dataset with one recipe file. Powered by Olostep.",
  "license": "MIT",
  "author": "Shaheer Amjad",
  "type": "module",
  "homepage": "https://github.com/Anasyaseen92/datarecipe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anasyaseen92/datarecipe.git"
  },
  "bugs": {
    "url": "https://github.com/Anasyaseen92/datarecipe/issues"
  },
  "bin": {
    "datarecipe": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "tsup --silent",
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "smoke": "npm run build && node dist/cli.js test/fixtures/mock-table.yml --mock --yes --out output/smoke && node dist/cli.js test/fixtures/mock-text.yml --mock --yes --out output/smoke"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "olostep": "^1.2.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^18.19.130",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "keywords": [
    "dataset",
    "web-scraping",
    "olostep",
    "ai",
    "csv",
    "huggingface",
    "cli"
  ]
}
